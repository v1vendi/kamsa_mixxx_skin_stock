/*
  kamsa (fork of Rekordmixxx) — base style (scheme independent). Accent-coloured "on" states live in
  scheme_*.qss, which Mixxx appends after this file.

  Design tokens (QSS has no variables; keep in sync by hand), sampled from rekordbox 7:
    window gap   #0a0a0a      waveform / pad / sampler / list black   #000000
    panel        #1e1e1e      fx / cfx row   #232323 / #191919
    button       #282828      button hover   #343434   pressed #404040
    header bar   #0b0b10
    text         #ffffff      text-dim #8c8c8c   text-off #555555
    cue ring     #f2a413      play ring #2ecc55  rec #ff2d2d  sampler tag #e6208a
    list select  #0b3f66      tree select #1f4255
*/

/* ---------- Typography: bundled fonts first, then OS natives ---------- */
#Mixxx, WWidget, WLabel, WPushButton, WNumber, WNumberPos, WNumberRate,
WKey, WTime, WTrackProperty, WRecordingDuration, WBeatSpinBox,
WEffectSelector, WSearchLineEdit, WLibrarySidebar, WTrackTableView,
WTrackTableViewHeader, WLibraryTextBrowser, QToolTip, QMenu {
  font-family: "Ioskeley Mono", "Helvetica Neue", monospace;
  font-weight: normal;
  font-size: 11px;
  color: #ffffff;
}

#Mixxx { background-color: #0a0a0a; }

/* ---------- Layout rhythm: 2 px hairlines between panels ---------- */
#SkinContainer { qproperty-layoutSpacing: 0; }
#PerformanceArea { qproperty-layoutSpacing: 2; padding: 0px; }
#WaveformsContainer { qproperty-layoutSpacing: 0; }
#DecksMixerRow { qproperty-layoutSpacing: 2; }

/* ---------- Global bar ---------- */
#GlobalBar {
  background-color: #0b0b10;
  border-bottom: 1px solid #000000;
  qproperty-layoutSpacing: 4;
  padding: 3px 8px 3px 8px;
}
#ModeName { font-size: 11px; font-weight: bold; letter-spacing: 0.5px; color: #ffffff; }
#GlobalMeters { qproperty-layoutSpacing: 2; qproperty-layoutAlignment: 'AlignVCenter'; }
#Clock { font-size: 12px; font-weight: bold; color: #ffffff; qproperty-alignment: AlignCenter; padding: 0px 0px 0px 2px; }

/* Panel toggles: dark square, icon; accent fill when on (scheme) */
WPushButton#PanelFx, WPushButton#PanelWaves, WPushButton#PanelSamplers, WPushButton#PanelMixer,
WPushButton#PanelMic, WPushButton#PanelDecks, WPushButton#PanelLibrary, WPushButton#PanelDeckWaves {
  background-color: #262626;
  border: 0;
  border-radius: 2px;
}
WPushButton#PanelFx:hover, WPushButton#PanelWaves:hover, WPushButton#PanelSamplers:hover,
WPushButton#PanelMixer:hover, WPushButton#PanelMic:hover, WPushButton#PanelDecks:hover,
WPushButton#PanelLibrary:hover, WPushButton#PanelDeckWaves:hover { background-color: #343434; }
WPushButton#PanelFx { image: url(skin:icons/fx.svg); }
WPushButton#PanelWaves { image: url(skin:icons/wave.svg); }
WPushButton#PanelSamplers { image: url(skin:icons/grid.svg); }
WPushButton#PanelMixer { image: url(skin:icons/mixer.svg); }
WPushButton#PanelMic { image: url(skin:icons/mic.svg); }
WPushButton#PanelDecks { image: url(skin:icons/decks.svg); }
WPushButton#PanelLibrary { image: url(skin:icons/library.svg); }
WPushButton#PanelDeckWaves { image: url(skin:icons/deck_wave.svg); } /* [AI-generated by Claude] */

/* ---------- Effect panel ---------- */
#FxPanel { background-color: #1e1e1e; border-bottom: 1px solid #000000; }
#FxRow { qproperty-layoutSpacing: 2; background-color: #000000; }
#FxUnit {
  background-color: #232323;
  qproperty-layoutSpacing: 8;
  padding: 4px 8px 4px 4px;
}
#FxSlot { qproperty-layoutSpacing: 2; }
#FxSlotRow { qproperty-layoutSpacing: 4; }
#FxAssign { qproperty-layoutSpacing: 2; }
#FxAssignRow { qproperty-layoutSpacing: 2; }
#FxKnobs { qproperty-layoutSpacing: 0; qproperty-layoutAlignment: 'AlignVCenter'; }
#CfxRow {
  background-color: #191919;
  qproperty-layoutSpacing: 8;
  padding: 3px 8px 3px 4px;
}
#CfxKnob { qproperty-layoutSpacing: 2; }
#FxUnitLabel { font-size: 12px; font-weight: bold; color: #6e6e6e; qproperty-alignment: AlignCenter; padding: 0px 0px 0px 2px; }
#CfxNumber { font-size: 11px; font-weight: bold; color: #8c8c8c; qproperty-alignment: AlignCenter; padding: 0px 0px 0px 2px; }
WPushButton#FxAssignButton { background-color: #1b1b1b; color: #8c8c8c; border-radius: 0; font-size: 10px; }
WPushButton#FxAssignButton:hover { background-color: #2c2c2c; }
WPushButton#FxEnableButton { background-color: #2d2d2d; color: #b4b4b4; border: 1px solid #3a3a3a; border-radius: 2px; font-size: 9px; }
WPushButton#FxEnableButton:hover { background-color: #383838; }
WEffectSelector {
  background-color: #2d2d2d;
  border: 0;
  border-radius: 2px;
  padding: 1px 8px 1px 8px;
  color: #ffffff;
  font-weight: bold;
  font-size: 10px;
}
WEffectSelector::drop-down { border: 0; width: 14px; }
WEffectSelector::down-arrow { image: url(skin:icons/chevron_down.svg); width: 10px; height: 10px; }
WEffectSelector QAbstractItemView {
  background-color: #1e1e1e;
  border: 1px solid #3a3a3a;
  selection-background-color: #0b3f66;
  selection-color: #ffffff;
  outline: none;
}

/* ---------- Waveform panel ---------- */
#Waveforms { background-color: #000000; qproperty-layoutSpacing: 0; }
#WaveformRows { qproperty-layoutSpacing: 2; }
#WaveformBox { qproperty-layoutSpacing: 0; background-color: #000000; }
#WaveformTab {
  background-color: #2b2b2b;
  qproperty-layoutSpacing: 2;
  padding: 4px 2px 4px 4px;
}
#WaveformTabNumber { font-size: 10px; font-weight: bold; color: #ffffff; }
#WaveformTabTop { qproperty-layoutSpacing: 0; }
#LoopPill { background-color: #1a1a1a; border-radius: 10px; qproperty-layoutSpacing: 0; }
WPushButton#LoopInButton, WPushButton#LoopOutButton {
  background-color: transparent; border: 0; border-radius: 10px; color: #ffffff; font-size: 12px; font-weight: bold;
}
WPushButton#LoopInButton:hover, WPushButton#LoopOutButton:hover { background-color: #3a3a3a; }
WPushButton#LoopInButton[pressed="true"], WPushButton#LoopOutButton[pressed="true"] { background-color: #4a4a4a; }
#ZoomStrip { background-color: #1e1e1e; qproperty-layoutSpacing: 2; qproperty-layoutAlignment: 'AlignHCenter'; }
WPushButton#ZoomButton {
  background-color: #2a2a2a; border: 0; border-radius: 2px; color: #cfcfcf; font-size: 10px; padding: 0;
}
WPushButton#ZoomButton:hover { background-color: #3a3a3a; }
/* [AI-generated by Claude] beat-grid adjust, beside the zoom strip */
#BeatGridStrip { background-color: #1e1e1e; border-right: 1px solid #141414; qproperty-layoutSpacing: 0; }
#BeatGridCell { qproperty-layoutSpacing: 0; qproperty-layoutAlignment: 'AlignHCenter'; }
WPushButton#BeatGridAdjust {
  background-color: #2a2a2a; border: 0; border-radius: 2px; padding: 2px 3px; image: url(skin:icons/beatgrid_adjust.svg);
}
WPushButton#BeatGridAdjust:hover { background-color: #3a3a3a; }
WPushButton#BeatGridAdjust[pressed="true"] { background-color: #4a4a4a; }

/* ---------- Player panel ---------- */
#Deck {
  background-color: #1e1e1e;
  qproperty-layoutSpacing: 0;
  padding: 6px;
}
#DeckMain { qproperty-layoutSpacing: 6; }
/* [AI-generated by Claude] deck-strip prototype: overview across the deck, above the pads and the compact turntable */
#DeckStrip { background-color: #1e1e1e; qproperty-layoutSpacing: 6; padding: 6px; }
#DeckStripRow { qproperty-layoutSpacing: 0; }

/* Title + artist: start of the line the Spinny continues across the platter (jog.xml);
   keep font, size and the 5 px inset in sync with <DeckReadout>. */
/* indent 0: QLabel otherwise indents by half an 'x' once it has padding, and the text
   would no longer line up with the Spinny's continuation */

/* Button row over the pads (button_row.xml) */
#ButtonRow, #ButtonCell { qproperty-layoutSpacing: 3; }
#KeyCell { qproperty-layoutSpacing: 2; background-color: #1f1f1f; border-radius: 2px; }

/* Track information */

#TrackTime { font-size: 14px; font-weight: bold; color: #ffffff; padding: 0px; qproperty-alignment: 'AlignRight | AlignVCenter'; }

#KeyReadout { font-size: 11px; font-weight: bold; color: #ffffff; qproperty-alignment: AlignCenter; }
WPushButton#KeySyncButton {
  background-color: #262626; border: 0; border-radius: 2px; color: #cfcfcf; font-size: 9px; font-weight: bold; padding: 0;
}
WPushButton#KeySyncButton:hover { background-color: #383838; }
WPushButton#KeySyncButton[pressed="true"] { background-color: #404040; }

WPushButton#KeyShiftButton {
  background-color: transparent; border: 1px solid #3a3a3a; border-radius: 2px; color: #cfcfcf; font-size: 14px; font-weight: bold; padding: 0;
}
WPushButton#KeyShiftButton:hover { color: #ffffff; border-color: #5a5a5a; }

#OverviewBox { background-color: transparent; qproperty-layoutSpacing: 0; }

/* Controls row */
#DeckControls { qproperty-layoutSpacing: 6; }
#PadStack { background-color: transparent; }
#PadPage { qproperty-layoutSpacing: 6; }
#PadGrid { qproperty-layoutSpacing: 3; }
#PadRow { qproperty-layoutSpacing: 3; qproperty-layoutAlignment: 'AlignVCenter'; }

WHotcueButton, WPushButton#PadButton {
  border: 0;
  border-radius: 2px;
  font-size: 15px;
  font-weight: normal;
  padding: 0px 6px 0px 6px;
}
WHotcueButton[displayValue="0"] { background-color: #0f0f0f; color: #4d4d4d; }
WHotcueButton[displayValue="0"]:hover { background-color: #1b1b1b; color: #8c8c8c; }
WHotcueButton[displayValue="1"] { background-color: #262626; border: 1px solid #333333; }
WHotcueButton[displayValue="1"]:hover { background-color: #303030; }
WHotcueButton[displayValue="2"] { background-color: #3a3a3a; border: 1px solid #e6e6e6; }
WHotcueButton[dark="true"] { color: #000000; }
WHotcueButton[light="true"] { color: #ffffff; }
WPushButton#PadButton { background-color: #161616; color: #9a9a9a; font-size: 13px; }
WPushButton#PadButton:hover { background-color: #242424; color: #ffffff; }
WPushButton#PadModeButton {
  background-color: transparent; border: 1px solid #3a3a3a; border-radius: 2px; color: #cfcfcf; font-size: 9px; font-weight: bold; padding: 0;
}
WPushButton#PadModeButton:hover { color: #ffffff; border-color: #5a5a5a; }

#Transport { qproperty-layoutSpacing: 0; }

WPushButton#QuantizeButton, WPushButton#MasterTempoButton {
  background-color: #262626; border: 0; border-radius: 2px; color: #cfcfcf; font-size: 9px; font-weight: bold; padding: 0;
}
WPushButton#QuantizeButton:hover,
WPushButton#MasterTempoButton:hover { background-color: #343434; color: #ffffff; }

/* CUE (orange ring) and PLAY (green ring) */
WPushButton#CueButton {
  background-color: #1e1e1e;
  border: 2px solid #f2a413;
  border-radius: 20px;
  color: #f2a413;
  font-size: 11px;
  font-weight: bold;
  padding: 0;
}
WPushButton#CueButton:hover { background-color: #2c2c2c; }
/* lit (deck sits on its cue point): warm tint + orange label; filled only while pressed */
WPushButton#CueButton[displayValue="1"] { background-color: #3a2a08; color: #f2a413; }
WPushButton#CueButton[pressed="true"] { background-color: #f2a413; color: #000000; }
WPushButton#PlayButton {
  background-color: #1e1e1e;
  border: 2px solid #2ecc55;
  border-radius: 20px;
  image: url(skin:icons/play_big.svg);
  /* [AI-generated by Claude] the image is scaled to the contents rect: 40 - 2 * (2 + 10) = 16 px */
  padding: 10px;
}
WPushButton#PlayButton:hover { background-color: #2c2c2c; }
/* [AI-generated by Claude — start] playing: dark green tint, brighter ring, pause icon */
WPushButton#PlayButton[displayValue="1"] { background-color: #174a26; border-color: #5cf283; image: url(skin:icons/play_big_playing.svg); }
WPushButton#PlayButton[displayValue="1"]:hover { background-color: #1f5c31; }
/* [AI-generated by Claude — end] */

/* Jog dial */
WSpinny, WSpinnyGLSL { font-family: "Ioskeley Mono", monospace; }

/* ---------- Mixer ---------- */
#Mixer {
  background-color: #1e1e1e;
  qproperty-layoutSpacing: 2;
  padding: 6px 4px 4px 4px;
}
#ChannelStrip { qproperty-layoutSpacing: 4; qproperty-layoutAlignment: 'AlignHCenter | AlignTop'; }

#MixKnobBox { qproperty-layoutSpacing: 0; qproperty-layoutAlignment: 'AlignHCenter'; }
#KnobBox { qproperty-layoutSpacing: 0; qproperty-layoutAlignment: 'AlignHCenter'; }

#VuBox { qproperty-layoutSpacing: 2; }

WPushButton#PflButton {
  background-color: #262626; border: 0; border-radius: 2px; color: #cfcfcf; font-size: 10px; font-weight: bold; padding: 0;
}
WPushButton#PflButton:hover { background-color: #343434; color: #ffffff; }

/* Mixer channels: flat, VU meters beside the faders towards the centre */
#Mixer { background-color: #141414; padding: 6px 4px 6px 4px; qproperty-layoutSpacing: 2; }
#ChannelStrip { qproperty-layoutSpacing: 3; }

#VuBox { qproperty-layoutSpacing: 2; padding-bottom: 2px; }
#MixKnobBox { qproperty-layoutSpacing: 0; qproperty-layoutAlignment: 'AlignHCenter'; }
#KnobColumn { qproperty-layoutSpacing: 0; }
#MixerRow { qproperty-layoutSpacing: 6; }
#KnobColumn WLabel#MixRowLabel { font-size: 8px; font-weight: bold; color: #6e6e6e; qproperty-alignment: 'AlignHCenter | AlignTop'; padding: 0px; }
/* channel meters run the full strip height, flush with the knobs and faders */
#ChannelStrip #VuBox { padding-bottom: 0px; }
WPushButton#PflButton {
  background-color: #2a2a2a; border: 0; border-radius: 2px; padding: 2px; image: url(skin:icons/headphones.svg);
}
WPushButton#PflButton[displayValue="1"] { background-color: #f2a413; }

/* ---------- Microphone / headphone / record row ---------- */

#HeadphoneIcon { background-image: url(skin:icons/headphones.svg); background-repeat: no-repeat; background-position: center; }
WPushButton#TalkoverButton {
  background-color: #262626; border: 0; border-radius: 2px; color: #cfcfcf; font-size: 9px; font-weight: bold; padding: 0;
}
WPushButton#TalkoverButton:hover { background-color: #343434; color: #ffffff; }
WPushButton#RecButton { background-color: #262626; border: 0; border-radius: 2px; image: url(skin:icons/rec_idle.svg); padding: 0; }
WPushButton#RecButton:hover { background-color: #343434; }
WPushButton#RecButton[displayValue="1"] { image: url(skin:icons/rec.svg); }
WPushButton#RecButton[displayValue="2"] { image: url(skin:icons/rec.svg); background-color: #4a1414; }
#RecDuration { font-size: 11px; color: #8c8c8c; qproperty-alignment: AlignCenter; padding: 0px 0px 0px 2px; }

/* ---------- Sampler deck ---------- */
#SamplerDeck { background-color: #0a0a0a; qproperty-layoutSpacing: 0; padding: 0px; }
#SamplerHalf { qproperty-layoutSpacing: 2; }
#SamplerRow { qproperty-layoutSpacing: 2; }
#SamplerSlot { background-color: #000000; border: 1px solid #1e1e1e; qproperty-layoutSpacing: 0; padding: 1px; }
#SamplerOverview { background-color: #000000; }
#SamplerBar { qproperty-layoutSpacing: 4; }
#SamplerTitle { font-size: 11px; color: #ffffff; }
/* tag: grey while the slot is empty, pink once a track is loaded (like rekordbox's sampler tiles).
   The group carries the colour (highlight property); the button on top is transparent. */
#SamplerTag { background-color: #262626; border-radius: 2px; qproperty-layoutSpacing: 0; }
#SamplerTag[highlight="1"] { background-color: #e6208a; }
WPushButton#SamplerPlayButton {
  background-color: transparent; border: 0; border-radius: 2px; color: #d4d4d4; font-size: 11px; font-weight: bold; padding: 0;
}
WPushButton#SamplerPlayButton:hover { background-color: rgba(255, 255, 255, 40); color: #ffffff; }
WPushButton#SamplerPlayButton[displayValue="1"] { background-color: #ffffff; color: #e6208a; }
WPushButton#SamplerLoadButton {
  background-color: #161616; border: 0; border-radius: 2px; image: url(skin:icons/folder.svg); padding: 0;
}
WPushButton#SamplerLoadButton:hover { background-color: #2a2a2a; }

/* [AI-generated by Claude — start] BPM column: no lock checkbox, just the value.
   ::item border 0 keeps the OS checkbox from being drawn underneath (Qt 6). */
#LibraryBPMButton::item { border: 0px; }
#LibraryBPMButton::indicator { width: 0px; height: 0px; image: none; border: none; background: transparent; }
/* [AI-generated by Claude — end] */

/* ---------- Preview panel ([AI-generated by Claude — start]) ----------
   A card at the foot of the browser's left column: header bar (click to fold), album art,
   title / artist, overview, transport, comment. */
#PreviewPanel { background-color: #161616; border-top: 1px solid #000000; qproperty-layoutSpacing: 0; padding: 0; }
#PreviewHeaderBox { background-color: #1a1a1a; border-bottom: 1px solid #0c0c0c; }
#PreviewHeaderLabel { color: #8c8c8c; font-size: 10px; font-weight: bold; letter-spacing: 1px;
  qproperty-alignment: 'AlignLeft | AlignVCenter'; qproperty-indent: 10; }
WPushButton#PreviewHeader {
  background-color: transparent; border: 0; border-radius: 0; padding: 0 10px;
  background-origin: content; background-position: right center; background-repeat: no-repeat;
  background-image: url(skin:icons/chevron_right.svg);
}
WPushButton#PreviewHeader[displayValue="1"] { background-image: url(skin:icons/chevron_down.svg); }
WPushButton#PreviewHeader:hover { background-color: rgba(255, 255, 255, 12); }
#PreviewBody { qproperty-layoutSpacing: 4; padding: 8px 8px 10px 8px; }
#PreviewInfo { qproperty-layoutSpacing: 10; }
#PreviewCoverBox { background-color: #000000; border: 1px solid #262626; border-radius: 3px; qproperty-layoutSpacing: 0; padding: 0; }
#PreviewText { qproperty-layoutSpacing: 0; }
#PreviewTitle { font-size: 13px; font-weight: bold; color: #ffffff; qproperty-alignment: 'AlignLeft | AlignVCenter'; padding-top: 2px; }
#PreviewArtist { font-size: 11px; color: #9a9a9a; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#PreviewOverview { background-color: #101010; border: 1px solid #262626; border-radius: 2px; }
#PreviewTransport { qproperty-layoutSpacing: 8; }
/* [AI-generated by Claude] play: the deck PLAY's green ring and icons at 30 px (icon 30 - 2 * (2 + 7) = 12 px) */
WPushButton#PreviewPlayButton {
  background-color: #1e1e1e; border: 2px solid #2ecc55; border-radius: 15px; padding: 7px;
  image: url(skin:icons/play_big.svg);
}
WPushButton#PreviewPlayButton:hover { background-color: #2c2c2c; }
WPushButton#PreviewPlayButton[displayValue="1"] { background-color: #174a26; border-color: #5cf283; image: url(skin:icons/play_big_playing.svg); }
WPushButton#PreviewPlayButton[displayValue="1"]:hover { background-color: #1f5c31; }
/* [AI-generated by Claude] output switch: a two-segment pill, the lit side is where the preview plays */
#PreviewRoute { background-color: #0c0c0c; border: 1px solid #2e2e2e; border-radius: 4px; qproperty-layoutSpacing: 0; padding: 0; }
WPushButton#PreviewRouteHp, WPushButton#PreviewRouteMain {
  background-color: transparent; border: 0; color: #6e6e6e; font-size: 9px; font-weight: bold; letter-spacing: 1px; padding: 0;
}
WPushButton#PreviewRouteHp { image: url(skin:icons/headphones.svg); padding: 4px 12px; border-top-left-radius: 3px; border-bottom-left-radius: 3px; }
WPushButton#PreviewRouteMain { border-top-right-radius: 3px; border-bottom-right-radius: 3px; }
WPushButton#PreviewRouteHp:hover, WPushButton#PreviewRouteMain:hover { background-color: #222222; color: #d4d4d4; }
WPushButton#PreviewRouteHp[displayValue="1"] { background-color: #f2a413; }
WPushButton#PreviewRouteMain[displayValue="1"] { background-color: #e6e6e6; color: #0c0c0c; }
#PreviewTime { font-size: 15px; color: #ffffff; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#PreviewBadges { qproperty-layoutSpacing: 4; }
#PreviewBpm, #PreviewKey { font-size: 10px; font-weight: bold; color: #d4d4d4; background-color: #262626; border-radius: 3px; qproperty-alignment: 'AlignCenter'; }
#PreviewKey { color: #d4d4d4; padding-left: 3px; }
#PreviewFieldLabel { font-size: 9px; font-weight: bold; color: #6e6e6e; letter-spacing: 1px; padding-top: 4px; }
/* a box so an empty comment is still something to click */
#PreviewGenre, #PreviewComment { font-size: 12px; color: #e6e6e6; background-color: #0c0c0c; border: 1px solid #2e2e2e; border-radius: 3px; padding: 0 6px; }
#PreviewGenre:hover, #PreviewComment:hover { border-color: #4a4a4a; }
/* selected = first click landed; the next click opens the editor */
#PreviewTitle[selected="true"], #PreviewArtist[selected="true"], #PreviewKey[selected="true"] { background-color: #0b3f66; }
#PreviewGenre[selected="true"], #PreviewComment[selected="true"] { border-color: #8c8c8c; background-color: #0b3f66; }
WTrackPropertyEditor { font-family: "Ioskeley Mono", "Helvetica Neue", monospace; font-size: 12px; background-color: #000000; color: #ffffff; border: 1px solid #8c8c8c; border-radius: 3px; padding: 0 5px; selection-background-color: #0b3f66; }
/* [AI-generated by Claude — end] */

/* ---------- Generic buttons ---------- */
WPushButton {
  background-color: #282828;
  border: 0;
  border-radius: 2px;
  color: #e6e6e6;
  font-size: 10px;
  font-weight: bold;
  padding: 0 4px;
}
WPushButton:hover { background-color: #343434; }

/* ---------- Browser ---------- */
#LibraryContainer { qproperty-layoutSpacing: 0; padding: 0px; background-color: #1e1e1e; }
#LibraryHeader { background-color: #1e1e1e; qproperty-layoutSpacing: 8; padding: 4px 8px 4px 10px; border-bottom: 1px solid #000000; }
#LibraryTitle { font-size: 11px; font-weight: bold; color: #8c8c8c; }
#LibrarySplitter { background-color: #0a0a0a; }
#SidebarBox { background-color: #1e1e1e; qproperty-layoutSpacing: 0; }
#TrackTableBox { qproperty-layoutSpacing: 0; }

WSearchLineEdit {
  background-color: #000000;
  border: 1px solid #333333;
  border-radius: 3px;
  padding: 1px 4px 1px 22px;
  color: #ffffff;
  selection-background-color: #0b3f66;
  background-image: url(skin:icons/search.svg);
  background-repeat: no-repeat;
  background-position: left center;
}
WSearchLineEdit:focus { border-color: #0e76f1; }
WSearchLineEdit::drop-down { border: 0; width: 0; }

WLibrarySidebar, WTrackTableView, WLibraryTextBrowser {
  background-color: #000000;
  alternate-background-color: #1a1a1a;
  border: 0;
  outline: none;
  color: #d4d4d4;
  selection-background-color: #0b3f66;
  selection-color: #ffffff;
}
WLibrarySidebar { background-color: #1e1e1e; alternate-background-color: #1e1e1e; color: #ffffff; font-size: 12px; }
WLibrarySidebar::item { padding: 3px 2px; }
WLibrarySidebar::item:selected { background-color: #1f4255; color: #ffffff; }
WLibrarySidebar::item:hover { background-color: #2a2a2a; }
WTrackTableView { gridline-color: transparent; font-size: 12px; }
WTrackTableView::item { padding: 0px 4px; }
/* [AI-generated by Claude] smaller preview icon in the track table (default one is 23 x 12) */
#LibraryPreviewButton { background: transparent; border: 0; padding: 3px 5px; } /* the icon scales to the padded box */
#LibraryPreviewButton:!checked { image: url(skin:icons/library_preview_play.svg); }
#LibraryPreviewButton:checked { image: url(skin:icons/library_preview_pause.svg); }
WTrackTableViewHeader { background-color: #1e1e1e; }
WTrackTableViewHeader::section {
  background-color: #1e1e1e;
  border: 0;
  border-right: 1px solid #000000;
  border-bottom: 1px solid #000000;
  padding: 3px 6px;
  color: #8c8c8c;
  font-weight: bold;
  font-size: 11px;
}

QSplitter::handle, WSplitter::handle { background-color: #0a0a0a; image: none; }
WSplitter::handle:hover { background-color: #2a2a2a; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 3px; }

QScrollBar:vertical { background: #0a0a0a; width: 10px; margin: 0; }
QScrollBar:horizontal { background: #0a0a0a; height: 10px; margin: 0; }
QScrollBar::handle { background: #3a3a3a; border-radius: 4px; min-height: 24px; min-width: 24px; margin: 2px; }
QScrollBar::handle:hover { background: #4a4a4a; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QToolTip {
  background-color: #2b2b2b;
  border: 1px solid #454545;
  color: #ffffff;
  padding: 3px;
}

/* Menus/popups shown by skin widgets (main menu bar is native) */
QMenu {
  background-color: #1e1e1e;
  border: 1px solid #3a3a3a;
  color: #ffffff;
}
QMenu::item:selected { background-color: #0b3f66; }

/* ---------- Library pages (Auto DJ, Analyze, Recordings, ...) and popups ---------- */
#LibraryFeatureControls QPushButton {
  background-color: #282828;
  color: #e6e6e6;
  border: 0;
  border-radius: 2px;
  margin: 0px 2px 3px 0px;
  padding: 0px 8px;
  height: 20px;
  min-width: 32px;
  font-weight: bold;
  font-size: 10px;
}
#DlgAutoDJ #LibraryFeatureControls QPushButton { padding: 0px; }
#LibraryFeatureControls QPushButton:hover { background-color: #343434; }
#LibraryFeatureControls QPushButton:disabled { background-color: #202020; color: #555555; }
#LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton {
  background: transparent;
  color: #d4d4d4;
  font-size: 11px;
}
#LibraryFeatureControls QRadioButton::indicator { width: 14px; height: 14px; }
QRadioButton { color: #d4d4d4; background: transparent; }
QCheckBox { color: #d4d4d4; background: transparent; }
QLabel#labelProgress, QLabel#labelSelectionInfo { margin: 2px 5px 5px 1px; color: #8c8c8c; }
QLabel#labelRecPrefix, QLabel#labelRecFilename, QLabel#labelRecStatistics { color: #d4d4d4; }

QSpinBox, QDoubleSpinBox, QLineEdit {
  background-color: #000000;
  color: #ffffff;
  border: 1px solid #333333;
  border-radius: 2px;
  padding: 1px 4px;
  selection-background-color: #0b3f66;
}
#fadeModeCombobox {
  background-color: #282828;
  color: #e6e6e6;
  border: 0;
  border-radius: 2px;
  padding: 1px 6px;
}
#fadeModeCombobox QAbstractItemView {
  background-color: #1e1e1e;
  color: #ffffff;
  selection-background-color: #0b3f66;
  border: 1px solid #3a3a3a;
}

WCueMenuPopup, WTrackMenu, WTrackMenu QMenu, WCoverArtMenu, WLibrarySidebar QMenu,
WTrackTableViewHeader QMenu, WColorPicker {
  background-color: #1e1e1e;
  color: #ffffff;
  border: 1px solid #3a3a3a;
}
WCueMenuPopup QLabel, WColorPicker QLabel { color: #d4d4d4; background: transparent; }
WCueMenuPopup QPushButton {
  background-color: #282828; color: #e6e6e6; border: 0; border-radius: 2px; padding: 3px 8px;
}
WCueMenuPopup QPushButton:hover { background-color: #343434; }
WTrackMenu::item:selected, WTrackMenu QMenu::item:selected { background-color: #0b3f66; }
WTrackMenu::item:disabled { color: #666666; }

/* [AI-generated by Claude — start] Side panel right of the right deck (side_panel.xml) */
#SidePanelBox { qproperty-layoutSpacing: 0; }
#SidePanel { background-color: #141414; padding: 6px 4px 6px 4px; qproperty-layoutSpacing: 4; }
#SidePanel #SideRow { qproperty-layoutSpacing: 6; }
#SidePanel #SideCol { qproperty-layoutSpacing: 2; }
#SidePanel #SideDivider { background-color: #262626; }
#SidePanel WLabel#SideLabel { font-size: 8px; font-weight: bold; color: #6e6e6e; qproperty-alignment: AlignCenter; padding: 0px; }
#SidePanel #RecDuration { font-size: 10px; padding: 0px; }
WPushButton#SidePanelTab { background-color: #1a1a1a; border: 0; border-left: 1px solid #262626; color: #8c8c8c; font-size: 12px; font-weight: bold; padding: 0; }
WPushButton#SidePanelTab:hover { background-color: #242424; color: #ffffff; }
/* [AI-generated by Claude — end] */
/* [AI-generated by Claude — start] Crossfader row at the foot of the mixer; side-panel crossfader toggle (blue = shown) */
#MixerXfader { border-top: 1px solid #262626; padding-top: 6px; margin-top: 4px; }
WPushButton#XfaderToggle { background-color: #262626; border: 0; border-radius: 2px; color: #8c8c8c; font-size: 8px; font-weight: bold; padding: 0; }
WPushButton#XfaderToggle:hover { background-color: #343434; color: #ffffff; }
WPushButton#XfaderToggle[displayValue="1"] { background-color: #0e76f1; color: #ffffff; }
/* [AI-generated by Claude — end] */
/* [AI-generated by Claude — start] Talk-over in the side panel: smaller text, red while on */
#SidePanel WPushButton#TalkoverButton { font-size: 8px; color: #8c8c8c; }
#SidePanel WPushButton#TalkoverButton[displayValue="1"] { background-color: #b3261e; color: #ffffff; }
/* [AI-generated by Claude — end] */

/* [AI-generated by Claude — start] 2- and 4-deck rows (turntable.xml, deck_wide_*.xml,
   deck_upright.xml, mixer4.xml). Deck colours are placeholders:
   1 green, 2 cyan, 3 pink, 4 violet. */
#DeckRows { qproperty-layoutSpacing: 0; }
#DeckRow2, #DeckRow4 { qproperty-layoutSpacing: 2; }
#DeckUpright { background-color: #1e1e1e; padding: 2px; qproperty-layoutSpacing: 4; }
#DeckDivider { background-color: #2a2a2a; }
#Turntable { background-color: #1e1e1e; }
WLabel#DeckBadge1, WLabel#DeckBadge2, WLabel#DeckBadge3, WLabel#DeckBadge4,
WLabel#MixChanBadge1, WLabel#MixChanBadge2, WLabel#MixChanBadge3, WLabel#MixChanBadge4 {
  border-radius: 2px; color: #111111; font-size: 12px; font-weight: bold; qproperty-alignment: AlignCenter;
}
WLabel#DeckBadge1, WLabel#MixChanBadge1 { background-color: #8fd14f; }
WLabel#DeckBadge2, WLabel#MixChanBadge2 { background-color: #22d3ee; }
WLabel#DeckBadge3, WLabel#MixChanBadge3 { background-color: #e879b9; }
WLabel#DeckBadge4, WLabel#MixChanBadge4 { background-color: #a78bfa; }
WLabel#MixChanBadge1, WLabel#MixChanBadge2, WLabel#MixChanBadge3, WLabel#MixChanBadge4 { font-size: 10px; margin: 0px 6px 0px 6px; }
#Mixer4Row { qproperty-layoutSpacing: 3; }
#Mixer4Col { qproperty-layoutSpacing: 4; }
#Mixer4Divider { background-color: #262626; }
WStarRating#DeckRating { color: #f2a413; background-color: transparent; }
#ButtonRow #ButtonCell { qproperty-layoutSpacing: 2; }
WPushButton#KeySyncButton { font-size: 8px; }
/* [AI-generated by Claude — end] */

/* [AI-generated by Claude — start] track info line over the overview (deck_info_line.xml) */
#DeckInfoLine { qproperty-layoutSpacing: 4; }
#InfoArtist { font-size: 12px; font-weight: normal; color: #b4b4b4; padding: 0px 0px 0px 2px; qproperty-alignment: 'AlignLeft | AlignVCenter'; }
#InfoBpm { font-size: 11px; font-weight: bold; color: #8a8a8a; padding: 0px 4px; qproperty-alignment: AlignCenter; }
/* [AI-generated by Claude — end] */
/* [AI-generated by Claude] original key of the file, on the info line */
#InfoKey { font-size: 11px; font-weight: bold; color: #8a8a8a; padding: 0px 4px 0px 0px; qproperty-alignment: AlignCenter; }
