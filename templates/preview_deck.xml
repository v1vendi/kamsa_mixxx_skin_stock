<!--
  [AI-generated by Claude — start]
  Preview panel ([PreviewDeck1], plays to the headphones) at the bottom of the browser's
  left column, under the source tree.  A header bar collapses it ([Kamsa],preview_expanded);
  [Skin],show_preview_decks (View menu) hides it altogether.
  Cover: the preview track's art once one is loaded, else the art of the track selected in
  the library (the browser's old album-art box).
  Title, artist and key are edited in place: click, pause, click again (Enter saves, Esc
  cancels); a double-click opens the track's properties dialog instead.  Genre and comment
  are edited the same way (stock Mixxx has no open-on-first-click option).
  [AI-generated by Claude — end]
-->
<Template>
  <SetVariable name="Group">[PreviewDeck1]</SetVariable>
  <WidgetGroup>
    <ObjectName>PreviewPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,max</SizePolicy>
    <Children>
      <!-- header: a label under a transparent, text-less button (WPushButton can't
           centre text vertically with left alignment); the stacked layout raises its
           first child, so the button goes first to sit on top and take the clicks -->
      <WidgetGroup>
        <ObjectName>PreviewHeaderBox</ObjectName>
        <Layout>stacked</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>60,26</MinimumSize>
        <MaximumSize>-1,26</MaximumSize>
        <Children>
          <PushButton>
            <ObjectName>PreviewHeader</ObjectName>
            <TooltipId>show_previewdeck</TooltipId>
            <Size>0me,26f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <Connection>
              <ConfigKey persist="true">[Kamsa],preview_expanded</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <Label>
            <ObjectName>PreviewHeaderLabel</ObjectName>
            <Text>PREVIEW</Text>
            <Size>0me,26f</Size>
          </Label>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>PreviewBody</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,max</SizePolicy>
        <Children>
          <!-- cover on the left, title / artist / BPM · key on the right (compact, so the tree keeps its room) -->
          <WidgetGroup>
            <ObjectName>PreviewInfo</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>-1,76</MinimumSize>
            <MaximumSize>-1,76</MaximumSize>
            <Children>
              <!-- album art: the two covers swap on track_loaded -->
              <WidgetGroup>
                <ObjectName>PreviewCoverBox</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>f,f</SizePolicy>
                <MinimumSize>76,76</MinimumSize>
                <MaximumSize>76,76</MaximumSize>
                <Children>
                  <CoverArt>
                    <ObjectName>PreviewCover</ObjectName>
                    <TooltipId>coverart</TooltipId>
                    <Group><Variable name="Group"/></Group>
                    <Size>76f,76f</Size>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </CoverArt>
                  <CoverArt>
                    <ObjectName>LibraryCover</ObjectName>
                    <TooltipId>coverart</TooltipId>
                    <Size>76f,76f</Size>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                      <Transform><Not/></Transform>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </CoverArt>
                </Children>
                <Connection>
                  <ConfigKey persist="true">[Skin],show_library_coverart</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>

              <WidgetGroup>
                <ObjectName>PreviewText</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>-1,76</MinimumSize>
                <MaximumSize>-1,76</MaximumSize>
                <Children>
                  <!-- 0me: a TrackProperty with an 'i' policy gets zero width -->
                  <TrackProperty>
                    <ObjectName>PreviewTitle</ObjectName>
                    <TooltipId>track_title</TooltipId>
                    <Group><Variable name="Group"/></Group>
                    <Property>titleInfo</Property>
                    <Elide>right</Elide>
                    <Size>0me,20f</Size>
                  </TrackProperty>
                  <TrackProperty>
                    <ObjectName>PreviewArtist</ObjectName>
                    <TooltipId>track_artist</TooltipId>
                    <Group><Variable name="Group"/></Group>
                    <Property>artist</Property>
                    <Elide>right</Elide>
                    <Size>0me,18f</Size>
                  </TrackProperty>
                  <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>PreviewBadges</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,f</SizePolicy>
                    <MinimumSize>-1,18</MinimumSize>
                    <MaximumSize>-1,18</MaximumSize>
                    <Children>
                      <TrackProperty>
                        <ObjectName>PreviewBpm</ObjectName>
                        <TooltipId>visual_bpm</TooltipId>
                        <Group><Variable name="Group"/></Group>
                        <Property>bpmText</Property>
                        <Size>52f,18f</Size>
                      </TrackProperty>
                      <!-- [AI-generated by Claude] WKey: the key's colour from the key palette, like the deck readout -->
                      <Key>
                        <ObjectName>PreviewKey</ObjectName>
                        <TooltipId>visual_key</TooltipId>
                        <Group><Variable name="Group"/></Group>
                        <Alignment>center</Alignment>
                        <Size>48f,18f</Size>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,visual_key</ConfigKey>
                        </Connection>
                      </Key>
                      <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
                    </Children>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>PreviewOverview</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>-1,30</MinimumSize>
            <MaximumSize>-1,30</MaximumSize>
            <Children>
              <Overview>
                <TooltipId>waveform_overview</TooltipId>
                <Group><Variable name="Group"/></Group>
                <SizePolicy>me,me</SizePolicy>
                <BgColor>#101010</BgColor>
                <SignalColor><Variable name="SignalColor"/></SignalColor>
                <SignalHighColor><Variable name="WaveHigh"/></SignalHighColor>
                <SignalMidColor><Variable name="WaveMid"/></SignalMidColor>
                <SignalLowColor><Variable name="WaveLow"/></SignalLowColor>
                <SignalRGBHighColor><Variable name="WaveHigh"/></SignalRGBHighColor>
                <SignalRGBMidColor><Variable name="WaveMid"/></SignalRGBMidColor>
                <SignalRGBLowColor><Variable name="WaveLow"/></SignalRGBLowColor>
                <PlayPosColor><Variable name="PlayPosColor"/></PlayPosColor>
                <PlayedOverlayColor><Variable name="PlayedOverlayColor"/></PlayedOverlayColor>
                <EndOfTrackColor><Variable name="EndOfTrackColor"/></EndOfTrackColor>
                <LabelFontSize>8</LabelFontSize>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                </Connection>
              </Overview>
            </Children>
          </WidgetGroup>

          <!-- transport: play (green, like the deck PLAY), time, output switch -->
          <WidgetGroup>
            <ObjectName>PreviewTransport</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>-1,30</MinimumSize>
            <MaximumSize>-1,30</MaximumSize>
            <Children>
              <PushButton>
                <ObjectName>PreviewPlayButton</ObjectName>
                <TooltipId>play_start</TooltipId>
                <Size>30f,30f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number></State>
                <State><Number>1</Number></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,play</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,start_stop</ConfigKey>
                  <ButtonState>RightButton</ButtonState>
                </Connection>
              </PushButton>
              <NumberPos>
                <ObjectName>PreviewTime</ObjectName>
                <TooltipId>track_time</TooltipId>
                <Group><Variable name="Group"/></Group>
                <Size>110f,30f</Size>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </NumberPos>
              <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
              <!-- [AI-generated by Claude — start]
                   output switch: headphones (pfl) or main mix (main_mix), never both.
                   Each button sets its own control and the inverse of the other one, so
                   clicking the lit one flips back as well.
                   [AI-generated by Claude — end] -->
              <WidgetGroup>
                <ObjectName>PreviewRoute</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>f,f</SizePolicy>
                <MinimumSize>80,22</MinimumSize>
                <MaximumSize>80,22</MaximumSize>
                <Children>
                  <PushButton>
                    <ObjectName>PreviewRouteHp</ObjectName>
                    <TooltipId>pfl</TooltipId>
                    <Size>40f,22f</Size>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text></Text></State>
                    <State><Number>1</Number><Text></Text></State>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,pfl</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,main_mix</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                      <Transform><Not/></Transform>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                  </PushButton>
                  <PushButton>
                    <ObjectName>PreviewRouteMain</ObjectName>
                    <TooltipId>main_enable</TooltipId>
                    <Size>40f,22f</Size>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>MAIN</Text></State>
                    <State><Number>1</Number><Text>MAIN</Text></State>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,main_mix</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,pfl</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                      <Transform><Not/></Transform>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <Label>
            <ObjectName>PreviewFieldLabel</ObjectName>
            <Text>GENRE</Text>
            <Size>0me,14f</Size>
          </Label>
          <TrackProperty>
            <ObjectName>PreviewGenre</ObjectName>
            <Tooltip>Genre: click to edit, Enter saves, Esc cancels</Tooltip>
            <Group><Variable name="Group"/></Group>
            <Property>genre</Property>
            <Elide>right</Elide>
            <Size>0me,26f</Size>
          </TrackProperty>
          <Label>
            <ObjectName>PreviewFieldLabel</ObjectName>
            <Text>COMMENT</Text>
            <Size>0me,14f</Size>
          </Label>
          <TrackProperty>
            <ObjectName>PreviewComment</ObjectName>
            <TooltipId>track_comment</TooltipId>
            <Group><Variable name="Group"/></Group>
            <Property>comment</Property>
            <Elide>right</Elide>
            <Size>0me,26f</Size>
          </TrackProperty>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Kamsa],preview_expanded</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey persist="true">[Skin],show_preview_decks</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
