<!--
  Deck button row between the overview and the pads: four equal cells (Ignored width policy,
  so Qt splits the row evenly) that line up with the four pad columns.
    1  pad mode (left click = next mode, right click = previous)
    2  key: < current key > ([AI-generated by Claude] the original key is on the info line)
    3  KEY SYNC, Q (quantize), MT (master tempo = keylock)
    4  track rating ([AI-generated by Claude] SYNC and M live on the platter)
  Variables: ChanNum, Mode, Group (inherited)
-->
<Template>
  <WidgetGroup>
    <ObjectName>ButtonRow</ObjectName>
    <Layout>horizontal</Layout>
    <Size>1me,28f</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>ButtonCell</ObjectName>
        <Layout>horizontal</Layout>
        <Size>1i,28f</Size>
        <Children>
          <PushButton>
            <ObjectName>PadModeButton</ObjectName>
            <Tooltip>Pad mode: left click = next, right click = previous</Tooltip>
            <Size>1me,28f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text><Variable name="Mode"/> &#x25BE;</Text></State>
            <Connection>
              <ConfigKey>[Kamsa],padmode_next_<Variable name="ChanNum"/></ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[Kamsa],padmode_prev_<Variable name="ChanNum"/></ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>KeyCell</ObjectName>
        <Layout>horizontal</Layout>
        <Size>1i,28f</Size>
        <Children>
          <!-- [AI-generated by Claude — start] shift buttons flush with the cell edges, the key
               centred between them; the file's original key is on the info line
               (deck_info_line.xml) [AI-generated by Claude — end] -->
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">KeyShiftButton</SetVariable>
            <SetVariable name="TooltipId">pitch_down</SetVariable>
            <SetVariable name="Size">18f,28f</SetVariable>
            <SetVariable name="Text">&#x2039;</SetVariable>
            <SetVariable name="LeftPush">true</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,pitch_down</SetVariable>
          </Template>
          <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
          <Key>
            <ObjectName>KeyReadout</ObjectName>
            <TooltipId>visual_key</TooltipId>
            <Group><Variable name="Group"/></Group>
            <Alignment>center</Alignment>
            <!-- WKey keeps 8 px for its colour bar outside its size hint: room for "G#m" -->
            <Size>34f,28f</Size>
            <Connection>
              <ConfigKey><Variable name="Group"/>,visual_key</ConfigKey>
            </Connection>
          </Key>
          <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">KeyShiftButton</SetVariable>
            <SetVariable name="TooltipId">pitch_up</SetVariable>
            <SetVariable name="Size">18f,28f</SetVariable>
            <SetVariable name="Text">&#x203A;</SetVariable>
            <SetVariable name="LeftPush">true</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,pitch_up</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>ButtonCell</ObjectName>
        <Layout>horizontal</Layout>
        <Size>1i,28f</Size>
        <Children>
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">KeySyncButton</SetVariable>
            <SetVariable name="TooltipId">sync_reset_key</SetVariable>
            <SetVariable name="Size">1me,28f</SetVariable>
            <SetVariable name="Text">KEY SYNC</SetVariable>
            <SetVariable name="LeftPush">true</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,sync_key</SetVariable>
          </Template>
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">QuantizeButton</SetVariable>
            <SetVariable name="TooltipId">quantize</SetVariable>
            <SetVariable name="Size">18f,28f</SetVariable>
            <SetVariable name="Text">Q</SetVariable>
            <SetVariable name="LeftPush">false</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,quantize</SetVariable>
          </Template>
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">MasterTempoButton</SetVariable>
            <SetVariable name="TooltipId">keylock</SetVariable>
            <SetVariable name="Size">22f,28f</SetVariable>
            <SetVariable name="Text">MT</SetVariable>
            <SetVariable name="LeftPush">false</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,keylock</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>ButtonCell</ObjectName>
        <Layout>horizontal</Layout>
        <Size>1i,28f</Size>
        <Children>
          <!-- [AI-generated by Claude — start] track rating over pad D; SYNC and M moved
               onto the platter next to the BPM box (turntable.xml) [AI-generated by Claude — end] -->
          <StarRating>
            <ObjectName>DeckRating</ObjectName>
            <TooltipId>starrating</TooltipId>
            <Group><Variable name="Group"/></Group>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>75,28</MinimumSize>
            <MaximumSize>-1,28</MaximumSize>
          </StarRating>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
