<!-- Whole-track overview of one deck. Variables: ChanNum, OvH ([AI-generated by Claude] height in px) -->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>OverviewBox</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,f</SizePolicy>
    <MinimumSize>-1,<Variable name="OvH"/></MinimumSize>
    <MaximumSize>-1,<Variable name="OvH"/></MaximumSize>
    <Children>
      <Overview>
        <TooltipId>waveform_overview</TooltipId>
        <Group><Variable name="Group"/></Group>
        <SizePolicy>me,me</SizePolicy>
        <BgColor><Variable name="OverviewBg"/></BgColor>
        <SignalColor><Variable name="SignalColor"/></SignalColor>
        <SignalHighColor><Variable name="WaveHigh"/></SignalHighColor>
        <SignalMidColor><Variable name="WaveMid"/></SignalMidColor>
        <SignalLowColor><Variable name="WaveLow"/></SignalLowColor>
        <SignalRGBHighColor><Variable name="WaveHigh"/></SignalRGBHighColor>
        <SignalRGBMidColor><Variable name="WaveMid"/></SignalRGBMidColor>
        <SignalRGBLowColor><Variable name="WaveLow"/></SignalRGBLowColor>
        <PlayPosColor><Variable name="PlayPosColor"/></PlayPosColor>
        <PlayedOverlayColor><Variable name="PlayedOverlayColor"/></PlayedOverlayColor>
        <EndOfTrackColor><Variable name="EndOfTrackColor"/></EndOfTrackColor>
        <LabelFontSize>11</LabelFontSize>
        <HotcueLetterLabels>true</HotcueLetterLabels>
        <TopHalfOnly>true</TopHalfOnly>
        <!-- [AI-generated by Claude] rekordbox-style 3-band look: blue body, orange rim and
             white crests where mids / highs rise above the lows; bands averaged over ±2 summary points -->
        <LowBandInFront>true</LowBandInFront>
        <Smoothing>1</Smoothing>
        <BandGains>1,0.35,0.8</BandGains>
        <StackBands>true</StackBands>
        <LabelTextColor>#bdbdbd</LabelTextColor>
        <DefaultMark>
          <Align>top|right</Align>
          <Color>#FF0000</Color>
          <TextColor>#000000</TextColor>
          <Text> %1 </Text>
        </DefaultMark>
        <Mark>
          <Control>cue_point</Control>
          <Text>&#x25BC;</Text>
          <Align>top|hcenter</Align>
          <Color>#E01E1E</Color>
          <TextColor>#E01E1E</TextColor>
        </Mark>
        <MarkRange>
          <StartControl>loop_start_position</StartControl>
          <EndControl>loop_end_position</EndControl>
          <EnabledControl>loop_enabled</EnabledControl>
          <Color><Variable name="LoopColor"/></Color>
          <Opacity>0.5</Opacity>
          <DisabledColor>#FFFFFF</DisabledColor>
          <DisabledOpacity>0.2</DisabledOpacity>
        </MarkRange>
        <Connection>
          <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
        </Connection>
      </Overview>
    </Children>
  </WidgetGroup>
</Template>
