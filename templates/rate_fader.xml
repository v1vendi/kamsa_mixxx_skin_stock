<!--
  Slim tempo fader on the outer edge of the deck: 26 px track, 32 px cap, full deck height.
  Blue bar = offset from 0 %.
  Variables: ChanNum, [AI-generated by Claude] FaderSize (e.g. 34f,228f)
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <Template src="skin:templates/controls/fader.xml">
    <SetVariable name="ObjectName">RateFader</SetVariable>
    <SetVariable name="TooltipId">rate</SetVariable>
    <SetVariable name="Size"><Variable name="FaderSize"/></SetVariable>
    <SetVariable name="Horizontal">false</SetVariable>
    <SetVariable name="Unipolar">false</SetVariable>
    <SetVariable name="Track">rate_track_slim.svg</SetVariable>
    <SetVariable name="Handle">rate_handle_wide.svg</SetVariable>
    <SetVariable name="BarAxisPos">17</SetVariable>
    <SetVariable name="ConfigKey"><Variable name="Group"/>,rate</SetVariable>
  </Template>
</Template>
