<!--
  Browser: search bar on top, source tree + artwork on the left, track list on the right.
  'me,i' vertical policy lets the library shrink instead of pushing the window taller.
-->
<Template>
  <WidgetGroup>
    <ObjectName>LibraryContainer</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,i</SizePolicy>
    <MinimumSize>-1,100</MinimumSize>
    <Children>
      <WidgetGroup>
        <ObjectName>LibraryHeader</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>-1,30</MinimumSize>
        <MaximumSize>-1,30</MaximumSize>
        <Children>
          <Label><ObjectName>LibraryTitle</ObjectName><Text>BROWSE</Text><Size>80f,22f</Size></Label>
          <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
          <SearchBox>
            <SizePolicy>f,f</SizePolicy>
            <MinimumSize>300,22</MinimumSize>
            <MaximumSize>300,22</MaximumSize>
          </SearchBox>
        </Children>
      </WidgetGroup>
      <Splitter>
        <ObjectName>LibrarySplitter</ObjectName>
        <Orientation>horizontal</Orientation>
        <SizePolicy>me,me</SizePolicy>
        <SplitSizes>220,900</SplitSizes>
        <SplitSizesConfigKey>[Kamsa],library_split</SplitSizesConfigKey>
        <Collapsible>1,0</Collapsible>
        <Children>
          <WidgetGroup>
            <ObjectName>SidebarBox</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,me</SizePolicy>
            <MinimumSize>160,-1</MinimumSize>
            <Children>
              <LibrarySidebar></LibrarySidebar>
              <!-- [AI-generated by Claude] preview deck + album art, under the tree -->
              <Template src="skin:templates/preview_deck.xml"/>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TrackTableBox</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <Library>
                <ShowButtonText>true</ShowButtonText>
                <!-- Overview column: same white / blue / orange as the deck waveforms -->
                <BgColor><Variable name="OverviewBg"/></BgColor>
                <SignalColor><Variable name="SignalColor"/></SignalColor>
                <SignalHighColor><Variable name="WaveHigh"/></SignalHighColor>
                <SignalMidColor><Variable name="WaveMid"/></SignalMidColor>
                <SignalLowColor><Variable name="WaveLow"/></SignalLowColor>
                <SignalRGBHighColor><Variable name="WaveHigh"/></SignalRGBHighColor>
                <SignalRGBMidColor><Variable name="WaveMid"/></SignalRGBMidColor>
                <SignalRGBLowColor><Variable name="WaveLow"/></SignalRGBLowColor>
              </Library>
            </Children>
          </WidgetGroup>
        </Children>
      </Splitter>
    </Children>
  </WidgetGroup>
</Template>
