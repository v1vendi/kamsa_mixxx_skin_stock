<!--
  [AI-generated by Claude — start]
  Collapsible side panel right of the right deck (replaces the old bottom row).
  Two 30 px columns, top to bottom:
    headphone icon
    MIX | LEVEL         headphone mix and gain
    MAIN | MIC          main gain + crossfader on/off ([Skin],show_xfader, hides the
                        mixer's crossfader) | mic gain + talk-over; the MIC column follows
                        [Skin],show_microphones
    REC                 record button and duration, pinned to the bottom
  The narrow tab on its left edge folds the panel away ([Kamsa],show_side_panel) and
  stays at the window edge while it is folded.
  [AI-generated by Claude — end]
-->
<Template>
  <WidgetGroup>
    <ObjectName>SidePanelBox</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>f,me</SizePolicy>
    <Children>
      <PushButton>
        <ObjectName>SidePanelTab</ObjectName>
        <Tooltip>Show or hide the headphone, main, mic and recording panel</Tooltip>
        <Size>12f,40me</Size>
        <NumberStates>2</NumberStates>
        <State><Number>0</Number><Text>&#x2039;</Text></State>
        <State><Number>1</Number><Text>&#x203A;</Text></State>
        <Connection>
          <ConfigKey persist="true">[Kamsa],show_side_panel</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>
      <WidgetGroup>
        <ObjectName>SidePanel</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>f,me</SizePolicy>
        <Children>
          <Label><ObjectName>HeadphoneIcon</ObjectName><Size>66f,14f</Size></Label>

          <!-- headphones -->
          <WidgetGroup>
            <ObjectName>SideRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>66f,42f</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>SideCol</ObjectName>
                <Layout>vertical</Layout>
                <Size>30f,42f</Size>
                <Children>
                  <Label><ObjectName>SideLabel</ObjectName><Text>MIX</Text><Size>30f,10f</Size></Label>
                  <Template src="skin:templates/controls/knob.xml">
                    <SetVariable name="ObjectName">HeadMixKnob</SetVariable>
                    <SetVariable name="TooltipId">headMix</SetVariable>
                    <SetVariable name="ArcUnipolar">false</SetVariable>
                    <SetVariable name="ConfigKey">[Master],headMix</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SideCol</ObjectName>
                <Layout>vertical</Layout>
                <Size>30f,42f</Size>
                <Children>
                  <Label><ObjectName>SideLabel</ObjectName><Text>LEVEL</Text><Size>30f,10f</Size></Label>
                  <Template src="skin:templates/controls/knob.xml">
                    <SetVariable name="ObjectName">HeadGainKnob</SetVariable>
                    <SetVariable name="TooltipId">headphone_gain</SetVariable>
                    <SetVariable name="ArcUnipolar">true</SetVariable>
                    <SetVariable name="ConfigKey">[Master],headGain</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><ObjectName>SideDivider</ObjectName><Size>66f,1f</Size></WidgetGroup>

          <!-- main + crossfader | mic -->
          <WidgetGroup>
            <ObjectName>SideRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>66f,64f</Size>
            <Children>
              <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
              <WidgetGroup>
                <ObjectName>SideCol</ObjectName>
                <Layout>vertical</Layout>
                <Size>30f,64f</Size>
                <Children>
                  <Label><ObjectName>SideLabel</ObjectName><Text>MAIN</Text><Size>30f,10f</Size></Label>
                  <Template src="skin:templates/controls/knob.xml">
                    <SetVariable name="ObjectName">MainGainKnob</SetVariable>
                    <SetVariable name="TooltipId">main_gain</SetVariable>
                    <SetVariable name="ArcUnipolar">true</SetVariable>
                    <SetVariable name="ConfigKey">[Master],gain</SetVariable>
                  </Template>
                  <PushButton>
                    <ObjectName>XfaderToggle</ObjectName>
                    <Tooltip>Show or hide the crossfader in the mixer</Tooltip>
                    <Size>30f,18f</Size>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>XF</Text></State>
                    <State><Number>1</Number><Text>XF</Text></State>
                    <Connection>
                      <ConfigKey persist="true">[Skin],show_xfader</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SideCol</ObjectName>
                <Layout>vertical</Layout>
                <Size>30f,64f</Size>
                <Children>
                  <Label><ObjectName>SideLabel</ObjectName><Text>MIC</Text><Size>30f,10f</Size></Label>
                  <Template src="skin:templates/controls/knob.xml">
                    <SetVariable name="ObjectName">MicGainKnob</SetVariable>
                    <SetVariable name="TooltipId">microphone_pregain</SetVariable>
                    <SetVariable name="ArcUnipolar">false</SetVariable>
                    <SetVariable name="ConfigKey">[Microphone],pregain</SetVariable>
                  </Template>
                  <Template src="skin:templates/controls/button.xml">
                    <SetVariable name="ObjectName">TalkoverButton</SetVariable>
                    <SetVariable name="TooltipId">microphone_talkover</SetVariable>
                    <SetVariable name="Size">30f,18f</SetVariable>
                    <SetVariable name="Text">TALK</SetVariable>
                    <SetVariable name="LeftPush">false</SetVariable>
                    <SetVariable name="ConfigKey">[Microphone],talkover</SetVariable>
                  </Template>
                </Children>
                <Connection>
                  <ConfigKey persist="true">[Skin],show_microphones</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1f,0me</Size></WidgetGroup>

          <!-- recorder -->
          <PushButton>
            <ObjectName>RecButton</ObjectName>
            <TooltipId>toggle_recording</TooltipId>
            <Size>66f,20f</Size>
            <NumberStates>3</NumberStates>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <State><Number>2</Number></State>
            <Connection>
              <ConfigKey>[Recording],toggle_recording</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey>[Recording],status</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <RecordingDuration>
            <ObjectName>RecDuration</ObjectName>
            <TooltipId>recording_duration</TooltipId>
            <InactiveText>00:00:00</InactiveText>
            <Size>66f,14f</Size>
          </RecordingDuration>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Kamsa],show_side_panel</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
