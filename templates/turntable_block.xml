<!--
  [AI-generated by Claude — start]
  Turntable block for stock Mixxx, laid out by turntable.xml (upright deck),
  turntable_wide.xml (2-deck) or turntable_compact.xml (deck strip), which set the sizes and
  positions below. Only stock widgets: the Spinny is a native GL window, so nothing may sit
  over it; every readout gets its own spot around the platter.
    title                 top, full width
    artist / BPM / key    line under the title
    platter               square Spinny under the info line, cover art inside the blue ring
    CUE / PLAY            40 px circles, bottom left
    time                  next to PLAY (click cycles elapsed / remaining / both)
    SYNC + M              stacked, left of the BPM box
    BPM box               bottom right: deck BPM and pitch %
    deck badge            top right, heading the tempo fader
    tempo fader           right edge
  Variables: ChanNum, BlockSize, TitlePos, TitleSize, InfoPos, InfoSize, PlatterPos,
  PlatterSize, CuePos, PlayPos, TimePos, TimeSize, SyncPos, LeaderPos, BpmPos, BadgePos,
  FaderPos, FaderSize
  [AI-generated by Claude — end]
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>Turntable</ObjectName>
    <Size><Variable name="BlockSize"/></Size>
    <Children>
      <TrackProperty>
        <ObjectName>DeckTitle</ObjectName>
        <TooltipId>track_title</TooltipId>
        <Group><Variable name="Group"/></Group>
        <Property>title</Property>
        <Elide>right</Elide>
        <Pos><Variable name="TitlePos"/></Pos>
        <Size><Variable name="TitleSize"/></Size>
      </TrackProperty>

      <WidgetGroup>
        <ObjectName>DeckInfoLine</ObjectName>
        <Layout>horizontal</Layout>
        <Pos><Variable name="InfoPos"/></Pos>
        <Size><Variable name="InfoSize"/></Size>
        <Children>
          <TrackProperty>
            <ObjectName>InfoArtist</ObjectName>
            <TooltipId>track_artist</TooltipId>
            <Group><Variable name="Group"/></Group>
            <Property>artist</Property>
            <Elide>right</Elide>
            <Size>1me,16f</Size>
          </TrackProperty>
          <TrackProperty>
            <ObjectName>InfoBpm</ObjectName>
            <Tooltip>Original BPM of the file</Tooltip>
            <Group><Variable name="Group"/></Group>
            <Property>bpmText</Property>
            <SizePolicy>min,f</SizePolicy>
            <MinimumSize>-1,16</MinimumSize>
            <MaximumSize>-1,16</MaximumSize>
          </TrackProperty>
          <TrackProperty>
            <ObjectName>InfoKey</ObjectName>
            <TooltipId>track_key</TooltipId>
            <Group><Variable name="Group"/></Group>
            <Property>keyText</Property>
            <SizePolicy>min,f</SizePolicy>
            <MinimumSize>-1,16</MinimumSize>
            <MaximumSize>-1,16</MaximumSize>
          </TrackProperty>
        </Children>
      </WidgetGroup>

      <Spinny>
        <TooltipId>spinny</TooltipId>
        <Pos><Variable name="PlatterPos"/></Pos>
        <Size><Variable name="PlatterSize"/></Size>
        <Group><Variable name="Group"/></Group>
        <PathBackground scalemode="STRETCH">skin:images/jog_bg.svg</PathBackground>
        <PathMask scalemode="STRETCH">skin:images/jog_mask.svg</PathMask>
        <PathForeground scalemode="STRETCH">skin:images/jog_marker.svg</PathForeground>
        <ShowCover>true</ShowCover>
      </Spinny>

      <PushButton>
        <ObjectName>CueButton</ObjectName>
        <TooltipId>cue_default_cue_gotoandstop</TooltipId>
        <Pos><Variable name="CuePos"/></Pos>
        <Size>40f,40f</Size>
        <NumberStates>2</NumberStates>
        <LeftClickIsPushButton>true</LeftClickIsPushButton>
        <RightClickIsPushButton>true</RightClickIsPushButton>
        <State><Number>0</Number><Text>CUE</Text></State>
        <State><Number>1</Number><Text>CUE</Text></State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_default</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_gotoandstop</ConfigKey>
          <ButtonState>RightButton</ButtonState>
          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_indicator</ConfigKey>
          <ConnectValueFromWidget>false</ConnectValueFromWidget>
        </Connection>
      </PushButton>

      <PushButton>
        <ObjectName>PlayButton</ObjectName>
        <TooltipId>play_cue_set</TooltipId>
        <Pos><Variable name="PlayPos"/></Pos>
        <Size>40f,40f</Size>
        <NumberStates>2</NumberStates>
        <State><Number>0</Number></State>
        <State><Number>1</Number></State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,play</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_set</ConfigKey>
          <ButtonState>RightButton</ButtonState>
          <EmitOnDownPress>true</EmitOnDownPress>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,play_indicator</ConfigKey>
          <ConnectValueFromWidget>false</ConnectValueFromWidget>
        </Connection>
      </PushButton>

      <NumberPos>
        <ObjectName>DeckTime</ObjectName>
        <TooltipId>track_time</TooltipId>
        <Pos><Variable name="TimePos"/></Pos>
        <Size><Variable name="TimeSize"/></Size>
        <Channel><Variable name="ChanNum"/></Channel>
        <Connection>
          <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
        </Connection>
      </NumberPos>

      <PushButton>
        <ObjectName>DeckSyncButton</ObjectName>
        <TooltipId>sync_enabled</TooltipId>
        <Pos><Variable name="SyncPos"/></Pos>
        <Size>40f,16f</Size>
        <NumberStates>2</NumberStates>
        <State><Number>0</Number><Text>SYNC</Text></State>
        <State><Number>1</Number><Text>SYNC</Text></State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,sync_enabled</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>
      <PushButton>
        <ObjectName>DeckLeaderButton</ObjectName>
        <TooltipId>sync_leader</TooltipId>
        <Pos><Variable name="LeaderPos"/></Pos>
        <Size>40f,16f</Size>
        <NumberStates>2</NumberStates>
        <State><Number>0</Number><Text>M</Text></State>
        <State><Number>1</Number><Text>M</Text></State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>

      <WidgetGroup>
        <ObjectName>TempoBox</ObjectName>
        <Layout>vertical</Layout>
        <Pos><Variable name="BpmPos"/></Pos>
        <Size>66f,34f</Size>
        <Children>
          <Number>
            <ObjectName>TempoBpm</ObjectName>
            <TooltipId>visual_bpm</TooltipId>
            <Size>66f,20f</Size>
            <NumberOfDigits>2</NumberOfDigits>
            <Connection>
              <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
            </Connection>
          </Number>
          <NumberRate>
            <ObjectName>TempoRate</ObjectName>
            <TooltipId>rate_display</TooltipId>
            <Size>66f,14f</Size>
            <Channel><Variable name="ChanNum"/></Channel>
            <NumberOfDigits>1</NumberOfDigits>
          </NumberRate>
        </Children>
      </WidgetGroup>

      <Label>
        <ObjectName>DeckBadge<Variable name="ChanNum"/></ObjectName>
        <Text><Variable name="ChanNum"/></Text>
        <Pos><Variable name="BadgePos"/></Pos>
        <Size>28f,18f</Size>
      </Label>
      <WidgetGroup>
        <ObjectName>RateFaderBox</ObjectName>
        <Layout>vertical</Layout>
        <Pos><Variable name="FaderPos"/></Pos>
        <Size><Variable name="FaderSize"/></Size>
        <Children>
          <Template src="skin:templates/rate_fader.xml"/>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
