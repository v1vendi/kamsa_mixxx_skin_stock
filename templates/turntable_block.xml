<!--
  [AI-generated by Claude — start]
  Turntable block, laid out by turntable.xml (classic deck) or turntable_compact.xml
  (deck strip), which set the sizes and positions below:
    platter               the Spinny, a non-square native GL window over the whole block
                          left of the tempo fader. Besides the platter it draws the
                          readout, since no skin widget can sit over it: the title (top
                          left, in one piece, running over the platter) with the artist and
                          the file's BPM / key on a line under it, CUE / PLAY (40 px circles,
                          bottom left), the elapsed / remaining time next to PLAY, SYNC + M
                          and the boxed BPM (bottom right); it fills its corners with the
                          deck colour
    deck badge            top right, heading the tempo fader
    tempo fader           right edge
  Variables: ChanNum, BlockSize, SpinnySize, PlatterOffsetX, TimeCenterY, CueButton, PlayButton, TempoBox,
  SyncButtons, BadgePos, FaderPos, FaderSize
  [AI-generated by Claude — end]
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>Turntable</ObjectName>
    <Size><Variable name="BlockSize"/></Size>
    <Children>
      <!-- [AI-generated by Claude] Readout positions are in block pixels. The time block, the
           BPM box and PLAY share one centre y. The beat-jog platter covers the whole Spinny
           (BeatJogFill), so it needs no background or foreground image. -->
      <Spinny>
        <TooltipId>spinny</TooltipId>
        <Pos>0,0</Pos>
        <Size><Variable name="SpinnySize"/></Size>
        <Group><Variable name="Group"/></Group>
        <ShowCover>true</ShowCover>
        <BeatJog>true</BeatJog>
        <BeatJogFill>#1e1e1e</BeatJogFill>
        <PlatterInset>9</PlatterInset>
        <!-- [AI-generated by Claude] the platter sits right of centre, clear of CUE / PLAY -->
        <PlatterOffsetX><Variable name="PlatterOffsetX"/></PlatterOffsetX>
        <StrobeColor>#ffd09b</StrobeColor>
        <DownbeatColor>#ff8a2e</DownbeatColor>
        <TempoRing>true</TempoRing>
        <DeckReadout>
          <TrackTextX>8</TrackTextX>
          <TitleTop>6</TitleTop>
          <TitleLines>2</TitleLines>
          <TitleSize>14</TitleSize>
          <!-- [AI-generated by Claude] artist, file BPM and key under the title -->
          <ArtistSize>11</ArtistSize>
          <TimeLeft>64</TimeLeft>
          <TimeCenterY><Variable name="TimeCenterY"/></TimeCenterY>
          <CueButton><Variable name="CueButton"/></CueButton>
          <PlayButton><Variable name="PlayButton"/></PlayButton>
          <TempoBox><Variable name="TempoBox"/></TempoBox>
          <SyncButtons><Variable name="SyncButtons"/></SyncButtons>
        </DeckReadout>
      </Spinny>

      <Label>
        <ObjectName>DeckBadge<Variable name="ChanNum"/></ObjectName>
        <Text><Variable name="ChanNum"/></Text>
        <Pos><Variable name="BadgePos"/></Pos>
        <Size>28f,18f</Size>
      </Label>
      <WidgetGroup>
        <ObjectName>RateFaderBox</ObjectName>
        <Layout>vertical</Layout>
        <Pos><Variable name="FaderPos"/></Pos>
        <Size><Variable name="FaderSize"/></Size>
        <Children>
          <Template src="skin:templates/rate_fader.xml"/>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
