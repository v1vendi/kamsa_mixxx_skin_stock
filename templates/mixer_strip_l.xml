<!--
  One mixer channel for the left side: knob column on the outside, PFL + volume
  fader, VU meter towards the centre.  Variables: ChanNum
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>ChannelStrip</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>f,me</SizePolicy>
    <Children>
      <Template src="skin:templates/mixer_knobs.xml"/>
      <Template src="skin:templates/mixer_pfl_fader.xml"/>
      <!-- [AI-generated by Claude — start] meter spans the fader: from the cap's top
           position down to the fader's end, above the headphone button (see mixer_pfl_fader.xml) [AI-generated by Claude — end] -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>f,me</SizePolicy>
        <Children>
          <WidgetGroup><Size>1f,12f</Size></WidgetGroup>
          <Template src="skin:templates/controls/vumeter.xml">
            <SetVariable name="TooltipId">channel_VuMeter</SetVariable>
            <SetVariable name="Suffix"></SetVariable>
          </Template>
          <WidgetGroup><Size>1f,32f</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
