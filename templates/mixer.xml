<!--
  Mixer panel of the 2-deck layout: channels 1 / 2.
  [AI-generated by Claude] The 4-deck layout uses mixer4.xml instead.
-->
<Template>
  <WidgetGroup>
    <ObjectName>Mixer</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>f,me</SizePolicy>
    <Children>
      <Template src="skin:templates/mixer_row.xml">
        <SetVariable name="Left">1</SetVariable>
        <SetVariable name="Right">2</SetVariable>
      </Template>
      <!-- [AI-generated by Claude — start] Crossfader under the channels (moved from the
           bottom row); hidden with [Skin],show_xfader, toggled from the side panel.
           [AI-generated by Claude — end] -->
      <WidgetGroup>
        <ObjectName>MixerXfader</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <Children>
          <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
          <Template src="skin:templates/controls/fader.xml">
            <SetVariable name="ObjectName">Crossfader</SetVariable>
            <SetVariable name="TooltipId">crossfader</SetVariable>
            <SetVariable name="Size">150f,22f</SetVariable>
            <SetVariable name="BarAxisPos">11</SetVariable>
            <SetVariable name="Horizontal">true</SetVariable>
            <SetVariable name="Unipolar">false</SetVariable>
            <SetVariable name="Track">fader_track_h.svg</SetVariable>
            <SetVariable name="Handle">fader_handle_h.svg</SetVariable>
            <SetVariable name="ConfigKey">[Master],crossfader</SetVariable>
          </Template>
          <WidgetGroup><Size>0me,1f</Size></WidgetGroup>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_xfader</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey persist="true">[Skin],show_mixer</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
