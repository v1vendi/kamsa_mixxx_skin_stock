<!--
  [AI-generated by Claude — start]
  2-deck layout, deck 2, right of the mixer: mixer | [turntable] [controls]
  The turntable (turntable_wide.xml) takes the half facing the mixer; the overview, button
  row and pads (deck_controls.xml) the outer half.  Variables: ChanNum
  [AI-generated by Claude — end]
-->
<Template>
  <!-- [AI-generated by Claude] classic deck, or the deck-strip prototype ([Kamsa],deck_overview_strip):
       the overview across the whole deck on the deck colour, above deck_strip_left/right.xml -->
  <WidgetGroup>
    <Layout>vertical</Layout>
    <SizePolicy>me,f</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>Deck</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <Children>
          <Template src="skin:templates/turntable_wide.xml"/>
          <WidgetGroup><Size>8f,1min</Size></WidgetGroup>
          <Template src="skin:templates/deck_controls.xml"><SetVariable name="OvH">60</SetVariable></Template>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Kamsa],deck_overview_strip</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform><Not/></Transform>
        </Connection>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>DeckStrip</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,f</SizePolicy>
        <Children>
          <Template src="skin:templates/deck_overview.xml">
            <SetVariable name="OvH">60</SetVariable>
            <SetVariable name="OverviewBg">#1e1e1e</SetVariable>
          </Template>
          <Template src="skin:templates/deck_strip_right.xml"/>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Kamsa],deck_overview_strip</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
